{
  "name": "momiz-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3021",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "auth:preflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-firebase-config.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "smoke:remote": "node scripts/remote-release-smoke.mjs",
    "test:e2e": "npm run test:e2e:check && playwright test",
    "test:e2e:check": "node scripts/check-playwright-browsers.mjs",
    "test:e2e:release": "playwright test --config=playwright.release.config.ts",
    "test:e2e:install": "playwright install chromium webkit",
    "openapi:generate": "node scripts/generate-professional-terms-contract.mjs --artifact-dir contracts/openapi/momiz-openapi-d91c5e6422617516458c00ee70a39c2babb72692",
    "openapi:check": "node scripts/generate-professional-terms-contract.mjs --check --artifact-dir contracts/openapi/momiz-openapi-d91c5e6422617516458c00ee70a39c2babb72692",
    "operations:validate": "node scripts/validate-runbooks.mjs",
    "operations:game-day": "node scripts/runbook-game-day.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.14.5",
    "@firebase/auth": "1.11.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  }
}
